# =====================================================================
#  SAFE CITY AI — Environment configuration
#  Copy to `.env` (never commit .env):
#     Windows:  copy .env.example .env
#     Linux:    cp .env.example .env
#  All values below are DEVELOPMENT defaults. No real secrets here.
# =====================================================================

# ---------- General ----------
ENVIRONMENT=development              # development | test | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                   # console (human readable) | json (structured, for production)

# ---------- PostgreSQL ----------
POSTGRES_USER=safecity
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=safecity
POSTGRES_HOST=localhost              # "postgres" inside docker-compose
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://safecity:change_me_dev_only@localhost:5432/safecity

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0   # redis://redis:6379/0 inside docker-compose

# ---------- Backend (FastAPI) ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_URL=http://localhost:8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Shared key the AI engine uses to call internal backend endpoints
INTERNAL_API_KEY=dev-only-internal-key-change-me
AUTH_ENABLED=false                   # auth-ready architecture; enable in production
RATE_LIMIT_PER_MINUTE=120
WS_MAX_CONNECTIONS=50

# ---------- AI Engine ----------
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8001
AI_ENGINE_URL=http://localhost:8001
DEFAULT_CAMERA_ID=CAM-001
USE_WEBCAM=false                      # Set to true to use live webcam in SOC dashboard/AI engine
WEBCAM_INDEX=0

# Models (auto-downloaded into ai-engine/models on first use)
YOLO_MODEL=yolo11n.pt                # yolo11n (fast) | yolo11s | yolo11m (more accurate, slower)
YOLO_POSE_MODEL=yolo11n-pose.pt
DEVICE=auto                          # auto | cpu | cuda | cuda:0 | mps
HALF_PRECISION=false                 # FP16 — only effective on CUDA

# Detection
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.50
INFERENCE_IMAGE_SIZE=640
DETECTION_CLASSES=person,bicycle,car,motorcycle,bus,truck,dog,cat,backpack,handbag,suitcase

# Tracking
TRACKER_TYPE=bytetrack               # bytetrack | botsort
TRACK_HISTORY_SIZE=90                # number of positions kept per track
TRACK_LOST_TIMEOUT_SECONDS=3.0

# Performance
INFERENCE_FPS=10                     # max AI inference rate per camera
FRAME_SKIP=0                         # process 1 of every (FRAME_SKIP+1) frames
PROCESS_WIDTH=960                    # frames resized to this width before inference (0 = no resize)
STREAM_JPEG_QUALITY=70
POSE_ENABLED=true

# Movement (pixel-based — NOT real-world speed; see README "Limitations")
STATIONARY_SPEED_PX=15               # below this px/s => stationary
RUNNING_SPEED_PX=180                 # above this px/s => running (between => walking)
SPEED_NORMALIZE_BY_HEIGHT=true       # normalise speed by person bbox height (perspective robustness)

# Loitering
LOITERING_TIME_SECONDS=120
LOITERING_RADIUS_PIXELS=100

# Crowd density
CROWD_THRESHOLD=20                   # > this => HIGH
CROWD_CRITICAL_THRESHOLD=40          # > this => CRITICAL

# Abandoned object
ABANDONED_OBJECT_SECONDS=60
ABANDONED_OWNER_DISTANCE_PX=150

# Events / Alerts
EVENT_COOLDOWN_SECONDS=30            # suppress duplicate events per track+type
ALERT_MIN_RISK_LEVEL=MEDIUM          # LOW | MEDIUM | HIGH | CRITICAL
RISK_RULES_FILE=configs/risk_rules.yaml

# Privacy
FACE_BLUR_ENABLED=true               # blur faces in stored evidence frames
STORE_RAW_VIDEO=false                # raw footage is NOT stored by default
EVIDENCE_DIR=evidence
EVIDENCE_RETENTION_DAYS=30

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8000/ws/events
NEXT_PUBLIC_AI_ENGINE_URL=http://localhost:8001
WEBSOCKET_URL=ws://localhost:8000/ws/events
